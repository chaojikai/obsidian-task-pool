{
  "name": "obsidian-task-pool",
  "version": "0.1.1",
  "description": "Obsidian plugin: fold completed tasks, tag tabs, drag list items",
  "main": "main.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/chaojikai/obsidian-task-pool.git"
  },
  "homepage": "https://github.com/chaojikai/obsidian-task-pool#readme",
  "bugs": {
    "url": "https://github.com/chaojikai/obsidian-task-pool/issues"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit -p tsconfig.json && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@types/node": "^22.20.2",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "tasks",
    "drag-and-drop"
  ],
  "author": "Link"
}
